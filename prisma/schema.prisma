generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Elemento {
  natureza
  agua
  fogo
  vento
}

/// Raça
model Raca {
  id                            Int                  @id @default(autoincrement())
  nome                          String
  descricao                     String?
  img                           String?
  icone                         String?
  corTema                       String?
  habilidadeDiariaNome          String?
  habilidadeDiariaCombate       String?
  habilidadeDiariaForaDeCombate String?
  hp                            Int?                 @default(0)
  mana                          Int?                 @default(0)
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  personagens                   Personagem[]
  campanhaNpcs                  CampanhaNpc[]
  npcTemplates                  NpcTemplateGeracao[]
}

/// Classe
model Classe {
  id                Int      @id @default(autoincrement())
  slug              String?  @unique // <-- opcional agora
  nome              String
  icone             String?
  corTema           String?
  subtitulo         String?
  descricao         String?
  gameplay          String?
  background        String?
  img_corpo         String?
  exemploPersonagem String?
  tags              Json?
  hp                Int?     @default(0)
  mana              Int?     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  personagens  Personagem[]
  campanhaNpcs CampanhaNpc[]
  npcTemplates NpcTemplateGeracao[]
  Magias       MagiaCatalog[]       @relation("ClasseMagias")
}

/// Campanha
model Campanha {
  id              Int           @id @default(autoincrement())
  nome            String
  sinopse         String?
  capa            String?
  count_jogadores Int?
  mestre          String?
  userId          String?
  tags            Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  personagens     Personagem[]
  npcs            CampanhaNpc[]
  combates        Combate[]
  user            User?         @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// NPC salvo na campanha
model CampanhaNpc {
  id               Int      @id @default(autoincrement())
  campanhaId       Int
  criadoPor        String?
  nome             String
  racaId           Int?
  racaNome         String
  genero           String
  classeId         Int?
  classeNome       String?
  profissao        String?
  importancia      String?
  tom              String?
  personalidade    String?
  aparencia        String?
  segredo          String?
  objetivoCampanha String
  gancho           String?
  frase            String?
  relacaoComGrupo  String?
  detalheVisual    String?
  descricao        String?
  dadosJson        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  raca     Raca?    @relation(fields: [racaId], references: [id], onDelete: SetNull)
  classe   Classe?  @relation(fields: [classeId], references: [id], onDelete: SetNull)

  @@index([campanhaId])
  @@index([racaId])
  @@index([classeId])
}

/// Template interno para geração procedural de NPC
model NpcTemplateGeracao {
  id          Int      @id @default(autoincrement())
  tipo        String
  valor       String
  racaId      Int?
  racaNome    String?
  genero      String?
  classeId    Int?
  classeNome  String?
  profissao   String?
  tom         String?
  importancia String?
  peso        Int      @default(1)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  raca   Raca?   @relation(fields: [racaId], references: [id], onDelete: SetNull)
  classe Classe? @relation(fields: [classeId], references: [id], onDelete: SetNull)

  @@index([tipo, ativo])
  @@index([racaId])
  @@index([classeId])
}

/// Estilo narrativo interno para descrições de NPC
model NpcEstiloNarrativo {
  id        Int      @id @default(autoincrement())
  chave     String   @unique
  nome      String
  descricao String?
  template  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Personagem
model Personagem {
  id                    Int                 @id @default(autoincrement())
  nome                  String
  apelido               String?
  descricao             String?
  anotacoes             String?
  userId                String?
  campanhaId            Int
  classeId              Int
  racaId                Int
  elemento              Elemento
  hp_atual              Int?
  mana_atual            Int?
  defesa_atual          Int?                @default(0)
  defesa_max            Int?                @default(0)
  habilidadeDiariaUsada Boolean             @default(false)
  hp_base               Int?
  mana_base             Int?
  imagemPerfil          String?             @map("imagem_perfil")
  imagemPrincipal       String?             @map("imagem_principal")
  statusEspecial        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  especialId            Int?
  itensInventario       ItemInventario[]
  magiaPersonagem       MagiaPersonagem[]
  periciaPersonagem     PericiaPersonagem[]
  combateParticipantes  CombateParticipante[]
  especial              Especial?           @relation(fields: [especialId], references: [id])
  campanha              Campanha            @relation(fields: [campanhaId], references: [id])
  classe                Classe              @relation(fields: [classeId], references: [id])
  raca                  Raca                @relation(fields: [racaId], references: [id])
  user                  User?               @relation(fields: [userId], references: [id])

  slotsDefensivos SlotsDefensivos?

  @@index([campanhaId])
  @@index([racaId])
  @@index([classeId])
  @@index([userId])
}

/// Catálogo de Magias
model MagiaCatalog {
  id          Int     @id @default(autoincrement())
  nome        String
  alcance     String?
  descricao   String?
  custo_nivel Int?
  classeId    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classe      Classe?           @relation("ClasseMagias", fields: [classeId], references: [id])
  personagens MagiaPersonagem[]

  @@unique([nome, classeId])
  @@index([classeId])
}

/// Vínculo Magia <-> Personagem
model MagiaPersonagem {
  id           Int          @id @default(autoincrement())
  personagemId Int
  magiaId      Int
  custo_nivel  Int?
  descricao    String?
  createdAt    DateTime     @default(now())
  magia        MagiaCatalog @relation(fields: [magiaId], references: [id])
  personagem   Personagem   @relation(fields: [personagemId], references: [id], onDelete: Cascade)

  @@index([personagemId])
  @@index([magiaId])
}

/// Catálogo de Perícias
model PericiaCatalog {
  id          Int                 @id @default(autoincrement())
  nome        String
  tipo        String              @default("")
  descricao   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  personagens PericiaPersonagem[]

  @@unique([nome, tipo])
}

/// Vínculo Perícia <-> Personagem
model PericiaPersonagem {
  id           Int            @id @default(autoincrement())
  personagemId Int
  periciaId    Int
  pontuacao    Int
  descricao    String?
  createdAt    DateTime       @default(now())
  pericia      PericiaCatalog @relation(fields: [periciaId], references: [id])
  personagem   Personagem     @relation(fields: [personagemId], references: [id], onDelete: Cascade)

  @@index([personagemId])
  @@index([periciaId])
}

enum ItemTipo {
  ARMA
  CONSUMIVEL
  MAGICO
  MATERIAL
  EQUIPAMENTO
}

model Item {
  id               Int              @id @default(autoincrement())
  nome             String
  tipo             ItemTipo
  descricao        String?
  notacaoRolagem   String?
  slots            Float            @default(1)
  durabilidadeBase Int?
  durabilidadeMax  Int?
  empilhavel       Boolean          @default(true)
  meta             Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  efeito           ItemEfeito?
  inventarios      ItemInventario[]

  @@index([tipo])
  @@index([nome])
}

enum ItemEfeitoModulo {
  VIDA
  MANA
  DEFESA
}

enum ItemEfeitoOperacao {
  ADICIONAR
  REMOVER
}

model ItemEfeito {
  id        Int                @id @default(autoincrement())
  itemId    Int                @unique
  modulo    ItemEfeitoModulo
  operacao  ItemEfeitoOperacao @default(ADICIONAR)
  valor     Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  item      Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([modulo])
}

model ItemInventario {
  id                Int        @id @default(autoincrement())
  personagemId      Int
  itemId            Int
  quantidade        Int        @default(1)
  durabilidadeAtual Int?
  durabilidadeMax   Int?
  efeitoAtivo       Boolean    @default(false)
  esgotadoEm        DateTime?
  observacoes       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  item              Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  personagem        Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)

  @@unique([personagemId, itemId])
  @@index([personagemId])
  @@index([itemId])
}

model Ameaca {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  nome           String
  tipo           String
  tipoSecundario String?
  elemento       String
  va             Float
  pv             Int
  mana           Int
  danoBase       String
  danoMedio      Int
  defesa         Int
  funcao         String
  reacoes        Json
  fraquezas      Json
  resistencias   Json
  imunidades     Json
  descricao      String
  narrativa      String
  golpes         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  combateParticipantes CombateParticipante[]

  @@index([tipo])
  @@index([elemento])
  @@index([va])
}

enum CombateStatus {
  RASCUNHO
  EM_ANDAMENTO
  ENCERRADO
}

enum CombateParticipanteTipo {
  PERSONAGEM
  AMEACA
}

model Combate {
  id          Int             @id @default(autoincrement())
  campanhaId  Int
  nome        String
  status      CombateStatus   @default(RASCUNHO)
  rodadaAtual Int             @default(1)
  turnoAtual  Int             @default(0)
  vaTotal     Float           @default(0)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  campanha      Campanha               @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  participantes CombateParticipante[]

  @@index([campanhaId])
  @@index([status])
}

model CombateParticipante {
  id           Int                      @id @default(autoincrement())
  combateId    Int
  tipo         CombateParticipanteTipo
  personagemId Int?
  ameacaId     Int?
  nome         String
  iniciativa   Int
  ordem        Int                      @default(0)
  hpAtual      Int?
  manaAtual    Int?
  bloqueioUsado Int                    @default(0)
  esquivaUsada Int                     @default(0)
  contraAtaqueUsado Int                @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  combate    Combate     @relation(fields: [combateId], references: [id], onDelete: Cascade)
  personagem Personagem? @relation(fields: [personagemId], references: [id], onDelete: SetNull)
  ameaca     Ameaca?     @relation(fields: [ameacaId], references: [id], onDelete: SetNull)

  @@index([combateId])
  @@index([personagemId])
  @@index([ameacaId])
  @@index([tipo])
}

model Especial {
  id          Int                  @id @default(autoincrement())
  nome        String
  descricao   String?
  meta        Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  roleActions EspecialRoleAction[]
  personagens Personagem[]
}

model EspecialRoleAction {
  id         Int      @id @default(autoincrement())
  especialId Int
  tipo       String
  acoes      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  especial   Especial @relation(fields: [especialId], references: [id], onDelete: Cascade)

  @@index([especialId, tipo])
}

model SlotsDefensivos {
  id                Int @id @default(autoincrement())
  personagemId      Int @unique
  esquivaUsada      Int @default(0)
  bloqueioUsado     Int @default(0)
  contraAtaqueUsado Int @default(0)

  personagem Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  image          String?
  emailVerified  DateTime?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  campanhas           Campanha[]
  personagens         Personagem[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  // 👇 senha apenas para credentials
  password String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
